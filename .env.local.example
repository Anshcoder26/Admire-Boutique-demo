# PostgreSQL Database URL from Vercel
# Get this from: Vercel Dashboard → Settings → Environment Variables → DATABASE_URL
# Copy the value and paste it below (keep it secret!)

DATABASE_URL=postgresql://user:password@host:port/dbname

# ---------------------------------------------------------------------------
# Transactional email (password resets, order confirmations, new-product blasts)
# ---------------------------------------------------------------------------
# Without RESEND_API_KEY the app still runs, but every email is a no-op and is
# only logged to the server console (see src/lib/mailer.ts). Password-reset and
# order-confirmation emails will NOT be delivered until this is set.
#
# Get a key at https://resend.com -> API Keys, then add it in Vercel:
#   Settings -> Environment Variables -> RESEND_API_KEY
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The verified "from" address for outgoing mail (must be a domain verified in Resend).
RESEND_FROM_EMAIL=Admire Boutique <no-reply@yourdomain.com>
# Address that receives admin/owner notifications (new orders, etc.)
ADMIN_EMAIL=owner@admireboutique.in

# ---------------------------------------------------------------------------
# Payments (Razorpay) - checkout payment fails without these
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Public site URL - used to build links in emails and redirects
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Admin bootstrap — used ONLY to seed the first admin account on an empty DB
# ---------------------------------------------------------------------------
# Required in production (min 8 chars). In development a random password is
# generated and logged once if this is unset. Rotate by updating the admin's
# password after first login; changing this value does NOT update an existing
# admin account (seeding only runs when admin_users is empty).
ADMIN_BOOTSTRAP_EMAIL=owner@admireboutique.in
ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-strong-secret

# ---------------------------------------------------------------------------
# Error tracking (optional) — DSN-gated, no-op when unset
# ---------------------------------------------------------------------------
# When set, server-side exceptions are forwarded to Sentry via the envelope API
# (see src/lib/error-tracking.ts). Leave blank to disable error reporting.
SENTRY_DSN=
